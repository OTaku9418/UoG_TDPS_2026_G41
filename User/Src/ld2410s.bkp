#include "ld2410s.h"
#include "usart.h"
#include "oled.h"
#include <stdio.h>
#include <math.h>

volatile uint16_t ld2410s_distance = 0;
uint8_t ld_rx_buf[1];
uint8_t ld_frame_buf[100];
uint8_t ld_packet_buf[100]; // 用于主循环解析缓冲

volatile uint8_t ld2410s_rx_ready = 0;

volatile uint32_t radar_gate_energy[3] = {0, 0, 0};
volatile int radar_avg_energy_20s = 0;
volatile int radar_current_avg_energy = 0;

static uint8_t history[20] = {0};
static uint8_t history_idx = 0;
static uint8_t history_cnt = 0;

// 状态机变量
static uint8_t rx_state = 0;
static uint8_t rx_head_idx = 0;
static uint8_t rx_packet_idx = 0;
static uint8_t rx_tail_idx = 0;

void LD2410S_Init(void)
{
    // 使能配置命令 (Enable configuration)
    uint8_t cmd_enable[] = {0xFD, 0xFC, 0xFB, 0xFA, 0x04, 0x00, 0xFF, 0x00, 0x01, 0x00, 0x04, 0x03, 0x02, 0x01};
    HAL_UART_Transmit(&huart4, cmd_enable, sizeof(cmd_enable), 100);
    HAL_Delay(50);
    
    // 切换为标准数据上报模式 (Switch to standard reporting mode)
    uint8_t cmd_standard[] = {0xFD, 0xFC, 0xFB, 0xFA, 0x08, 0x00, 0x7A, 0x00, 
                                0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 
                                0x04, 0x03, 0x02, 0x01};
    HAL_UART_Transmit(&huart4, cmd_standard, sizeof(cmd_standard), 100);
    HAL_Delay(50);
    
    // 结束配置命令 (Disable configuration)
    uint8_t cmd_disable[] = {0xFD, 0xFC, 0xFB, 0xFA, 0x02, 0x00, 0xFE, 0x00, 0x04, 0x03, 0x02, 0x01};
    HAL_UART_Transmit(&huart4, cmd_disable, sizeof(cmd_disable), 100);
    HAL_Delay(50);
    
    // 清除初始化期间由于未及时读取ACK而产生的溢出错误(ORE)标志
    __HAL_UART_CLEAR_OREFLAG(&huart4);
    // 清空可能残留在数据寄存器中的无效字节
    volatile uint32_t tmpreg = huart4.Instance->DR;
    (void)tmpreg;
    
    // 开启 UART4 接收中断 (Start receiving using interrupt)
    HAL_UART_Receive_IT(&huart4, ld_rx_buf, 1);
}

void LD2410S_SoftRestart(void)
{
    // 使能配置命令 (进入配置模式，打断雷达当前状态)
    uint8_t cmd_enable[] = {0xFD, 0xFC, 0xFB, 0xFA, 0x04, 0x00, 0xFF, 0x00, 0x01, 0x00, 0x04, 0x03, 0x02, 0x01};
    HAL_UART_Transmit(&huart4, cmd_enable, sizeof(cmd_enable), 100);
    HAL_Delay(50);
    
    // 结束配置命令 (退出配置模式，让雷达基于当前环境重新开始检测)
    uint8_t cmd_disable[] = {0xFD, 0xFC, 0xFB, 0xFA, 0x02, 0x00, 0xFE, 0x00, 0x04, 0x03, 0x02, 0x01};
    HAL_UART_Transmit(&huart4, cmd_disable, sizeof(cmd_disable), 100);
    HAL_Delay(50);
}

// 错误处理回调，解决 ORE 死机问题
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if(huart->Instance == UART4)
    {
        // 清除 ORE 等错误标志
        __HAL_UART_CLEAR_OREFLAG(huart);
        // 重新开启接收中断
        HAL_UART_Receive_IT(&huart4, ld_rx_buf, 1);
    }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if(huart->Instance == UART4)
    {
        uint8_t RxData = ld_rx_buf[0];
        
        // 状态机解析
        switch(rx_state)
        {
            case 0: // 匹配标准包头 F4 F3 F2 F1
                if (rx_head_idx == 0 && RxData == 0xF4) rx_head_idx = 1;
                else if (rx_head_idx == 1 && RxData == 0xF3) rx_head_idx = 2;
                else if (rx_head_idx == 2 && RxData == 0xF2) rx_head_idx = 3;
                else if (rx_head_idx == 3 && RxData == 0xF1) {
                    rx_state = 1; // 进入接收内容状态
                    rx_packet_idx = 0;
                    rx_tail_idx = 0;
                    rx_head_idx = 0;
                } else {
                    rx_head_idx = (RxData == 0xF4) ? 1 : 0; // 防止重叠粘包
                }
                break;
                
            case 1: // 接收固定长度的内容 (采用官方逻辑：72字节，不含帧头和帧尾)
                if (rx_packet_idx < 72)
                {
                    ld_frame_buf[rx_packet_idx] = RxData;
                    rx_packet_idx++;
                    if (rx_packet_idx >= 72)
                    {
                        rx_state = 2; // 进入校验帧尾状态
                    }
                }
                break;
                
            case 2: // 匹配帧尾 F8 F7 F6 F5
                if (rx_tail_idx == 0 && RxData == 0xF8) rx_tail_idx = 1;
                else if (rx_tail_idx == 1 && RxData == 0xF7) rx_tail_idx = 2;
                else if (rx_tail_idx == 2 && RxData == 0xF6) rx_tail_idx = 3;
                else if (rx_tail_idx == 3 && RxData == 0xF5) {
                    // 接收完整帧，拷贝数据并通知主循环
                    for(int i = 0; i < 72; i++) {
                        ld_packet_buf[i] = ld_frame_buf[i];
                    }
                    ld2410s_rx_ready = 1; // 设置标志位，让主循环处理
                    rx_state = 0;
                    rx_tail_idx = 0;
                } else {
                    // 帧尾不匹配，复位
                    rx_state = 0;
                    rx_head_idx = (RxData == 0xF4) ? 1 : 0;
                }
                break;
        }

        // 继续开启下一次中断接收
        HAL_UART_Receive_IT(&huart4, ld_rx_buf, 1);
    }
}

void LD2410S_DebugEnergy(void)
{
    OLED_Clear();
    OLED_ShowString(0, 0, "LD2410S IT Debug");

    while(1)
    {
        if (ld2410s_rx_ready)
        {
            ld2410s_rx_ready = 0; // 清除标志位
            
            // 提取门限能量 
            // 由于去掉了4字节包头，因此偏移量减4，原来是 12、16、20 现在变为了 8、12、16
            uint32_t p0 = ld_packet_buf[8] | (ld_packet_buf[9]<<8) | (ld_packet_buf[10]<<16) | (ld_packet_buf[11]<<24);
            uint32_t p1 = ld_packet_buf[12] | (ld_packet_buf[13]<<8) | (ld_packet_buf[14]<<16) | (ld_packet_buf[15]<<24);
            uint32_t p2 = ld_packet_buf[16] | (ld_packet_buf[17]<<8) | (ld_packet_buf[18]<<16) | (ld_packet_buf[19]<<24);
            
            radar_gate_energy[0] = p0;
            radar_gate_energy[1] = p1;
            radar_gate_energy[2] = p2;
            
            // 进行复杂的浮点运算
            int db0 = p0 > 0 ? log10(p0)*10 : 0;
            int db1 = p1 > 0 ? log10(p1)*10 : 0;
            int db2 = p2 > 0 ? log10(p2)*10 : 0;
            
            radar_current_avg_energy = (db0 + db1 + db2) / 3;
            
            history[history_idx] = radar_current_avg_energy;
            history_idx = (history_idx + 1) % 20; // 1Hz对应20个样本 (若雷达为10Hz则2秒存满)
            if (history_cnt < 20) history_cnt++;
            
            uint32_t sum = 0;
            for (int i = 0; i < history_cnt; i++) sum += history[i];
            radar_avg_energy_20s = sum / history_cnt;
            
            // 刷新 OLED
            char str[20];
            sprintf(str, "G0:%2d G1:%2d G2:%2d", db0, db1, db2);
            OLED_ShowString(0, 2, str);
            
            sprintf(str, "Cur Avg: %3d  ", radar_current_avg_energy);
            OLED_ShowString(0, 4, str);
            
            sprintf(str, "20s Avg: %3d  ", radar_avg_energy_20s);
            OLED_ShowString(0, 6, str);
        }
        
        HAL_Delay(10); // 小延时避免空跑占满 CPU
    }
}
